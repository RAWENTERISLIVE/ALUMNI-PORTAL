// Add a reaction to a post
export const reactToPost = async (req: AuthRequest, res: Response): Promise<void> => {
  try {
    const { postId } = req.params;
    const { type } = req.body;
    const userId = req.user?.id;
    
    if (!userId) {
      res.status(400).json({ success: false, message: 'User ID is required' });
      return;
    }

    // Validate reaction type
    const validReactionTypes = ['like', 'love', 'celebrate', 'support', 'insightful', 'funny'];
    if (!validReactionTypes.includes(type)) {
      res.status(400).json({ 
        success: false, 
        message: `Invalid reaction type. Must be one of: ${validReactionTypes.join(', ')}` 
      });
      return;
    }

    const post = await Post.findById(postId);
    if (!post) {
      res.status(404).json({ success: false, message: 'Post not found' });
      return;
    }

    // Initialize reactions array if it doesn't exist
    if (!post.reactions) {
      post.reactions = [];
    }

    // Remove any existing reaction from this user
    post.reactions = post.reactions.filter(reaction => reaction.userId.toString() !== userId.toString());
    
    // Add the new reaction
    post.reactions.push({
      userId: userId as any,
      type: type as any
    });

    // If it's a "like" reaction, update the likes array for backward compatibility
    if (type === 'like') {
      if (!post.likes.includes(userId as any)) {
        post.likes.push(userId as any);
      }
    } else {
      // Remove from likes array if present and the new reaction isn't "like"
      const likeIndex = post.likes.findIndex(id => id.toString() === userId.toString());
      if (likeIndex !== -1) {
        post.likes.splice(likeIndex, 1);
      }
    }

    await post.save();

    // Get counts of each reaction type
    const reactionCounts = validReactionTypes.reduce((counts: Record<string, number>, reactionType) => {
      counts[reactionType] = post.reactions!.filter(r => r.type === reactionType).length;
      return counts;
    }, {});

    res.json({ 
      success: true, 
      message: 'Reaction added',
      reactions: reactionCounts,
      likes: post.likes.length // For backward compatibility
    });
  } catch (error: any) {
    res.status(500).json({ success: false, message: 'Failed to add reaction', error: error.message });
  }
};

// Remove a reaction from a post
export const removeReaction = async (req: AuthRequest, res: Response): Promise<void> => {
  try {
    const { postId } = req.params;
    const userId = req.user?.id;
    
    if (!userId) {
      res.status(400).json({ success: false, message: 'User ID is required' });
      return;
    }

    const post = await Post.findById(postId);
    if (!post) {
      res.status(404).json({ success: false, message: 'Post not found' });
      return;
    }

    // Check if user has a reaction
    if (!post.reactions || !post.reactions.some(r => r.userId.toString() === userId.toString())) {
      res.status(400).json({ success: false, message: 'No reaction to remove' });
      return;
    }

    // Remove the reaction
    post.reactions = post.reactions.filter(reaction => reaction.userId.toString() !== userId.toString());
    
    // Also remove from likes array if present
    const likeIndex = post.likes.findIndex(id => id.toString() === userId.toString());
    if (likeIndex !== -1) {
      post.likes.splice(likeIndex, 1);
    }

    await post.save();

    // Get counts of each reaction type
    const validReactionTypes = ['like', 'love', 'celebrate', 'support', 'insightful', 'funny'];
    const reactionCounts = validReactionTypes.reduce((counts: Record<string, number>, reactionType) => {
      counts[reactionType] = post.reactions!.filter(r => r.type === reactionType).length;
      return counts;
    }, {});

    res.json({ 
      success: true, 
      message: 'Reaction removed',
      reactions: reactionCounts,
      likes: post.likes.length // For backward compatibility
    });
  } catch (error: any) {
    res.status(500).json({ success: false, message: 'Failed to remove reaction', error: error.message });
  }
};

// Bookmark a post
export const bookmarkPost = async (req: AuthRequest, res: Response): Promise<void> => {
  try {
    const { postId } = req.params;
    const userId = req.user?.id;
    
    if (!userId) {
      res.status(400).json({ success: false, message: 'User ID is required' });
      return;
    }

    const post = await Post.findById(postId);
    if (!post) {
      res.status(404).json({ success: false, message: 'Post not found' });
      return;
    }

    // Initialize bookmarks array if it doesn't exist
    if (!post.bookmarks) {
      post.bookmarks = [];
    }

    // Check if user has already bookmarked the post
    if (post.bookmarks.includes(userId as any)) {
      res.status(400).json({ success: false, message: 'Post already bookmarked' });
      return;
    }

    // Add user's ID to the bookmarks array
    post.bookmarks.push(userId as any);
    await post.save();

    res.json({ 
      success: true, 
      message: 'Post bookmarked successfully',
      bookmarkCount: post.bookmarks.length
    });
  } catch (error: any) {
    res.status(500).json({ success: false, message: 'Failed to bookmark post', error: error.message });
  }
};

// Remove bookmark from a post
export const removeBookmark = async (req: AuthRequest, res: Response): Promise<void> => {
  try {
    const { postId } = req.params;
    const userId = req.user?.id;
    
    if (!userId) {
      res.status(400).json({ success: false, message: 'User ID is required' });
      return;
    }

    const post = await Post.findById(postId);
    if (!post) {
      res.status(404).json({ success: false, message: 'Post not found' });
      return;
    }

    // Check if user has bookmarked the post
    if (!post.bookmarks || !post.bookmarks.includes(userId as any)) {
      res.status(400).json({ success: false, message: 'Post not bookmarked' });
      return;
    }

    // Remove user's ID from the bookmarks array
    post.bookmarks = post.bookmarks.filter(id => id.toString() !== userId.toString());
    await post.save();

    res.json({ 
      success: true, 
      message: 'Bookmark removed successfully',
      bookmarkCount: post.bookmarks.length
    });
  } catch (error: any) {
    res.status(500).json({ success: false, message: 'Failed to remove bookmark', error: error.message });
  }
};

// Vote on a poll
export const voteOnPoll = async (req: AuthRequest, res: Response): Promise<void> => {
  try {
    const { postId } = req.params;
    const { optionIndex } = req.body;
    const userId = req.user?.id;
    
    if (!userId) {
      res.status(400).json({ success: false, message: 'User ID is required' });
      return;
    }

    const post = await Post.findById(postId);
    if (!post) {
      res.status(404).json({ success: false, message: 'Post not found' });
      return;
    }

    if (!post.pollOptions || post.pollOptions.length === 0) {
      res.status(400).json({ success: false, message: 'This post does not contain a poll' });
      return;
    }

    // Check if poll has ended
    if (post.pollEndsAt && new Date(post.pollEndsAt) < new Date()) {
      res.status(400).json({ success: false, message: 'This poll has ended' });
      return;
    }

    if (optionIndex < 0 || optionIndex >= post.pollOptions.length) {
      res.status(400).json({ success: false, message: 'Invalid option index' });
      return;
    }

    // Check if user has already voted on this poll
    const hasVoted = post.pollOptions.some(option => 
      option.votes && option.votes.includes(userId as any)
    );

    // Remove existing vote if any
    if (hasVoted) {
      post.pollOptions.forEach(option => {
        option.votes = option.votes.filter(id => id.toString() !== userId.toString());
      });
    }

    // Add vote to selected option
    post.pollOptions[optionIndex].votes.push(userId as any);
    await post.save();

    // Format response to include vote counts
    const pollResults = post.pollOptions.map(option => ({
      text: option.text,
      voteCount: option.votes.length
    }));

    res.json({ 
      success: true, 
      message: hasVoted ? 'Vote changed successfully' : 'Vote recorded successfully',
      pollResults
    });
  } catch (error: any) {
    res.status(500).json({ success: false, message: 'Failed to record vote', error: error.message });
  }
};

// Share a post
export const sharePost = async (req: AuthRequest, res: Response): Promise<void> => {
  try {
    const { postId } = req.params;
    const { comment } = req.body;
    const userId = req.user?.id || req.user?._id;

    if (!userId) {
      res.status(401).json({
        success: false,
        message: 'Unauthorized'
      });
      return;
    }

    const originalPost = await Post.findById(postId);
    if (!originalPost) {
      res.status(404).json({
        success: false,
        message: 'Post not found'
      });
      return;
    }

    // Increment share count on the original post
    originalPost.shareCount = (originalPost.shareCount || 0) + 1;
    await originalPost.save();

    // If there's a comment, create a new post as a share with comment (quote post)
    if (comment && comment.trim()) {
      // Create a new post that references the original
      const newPost = new Post({
        content: comment.trim(),
        author: userId,
        sharedPost: postId,
        visibility: originalPost.visibility === 'private' ? 'connections_only' : originalPost.visibility,
        shareType: 'quote'
      });

      await newPost.save();

      res.json({
        success: true,
        message: 'Post shared with comment',
        data: {
          shareCount: originalPost.shareCount,
          post: newPost
        }
      });
    } else {
      // Simple share without creating a new post
      res.json({
        success: true,
        message: 'Post shared',
        data: {
          shareCount: originalPost.shareCount
        }
      });
    }
  } catch (error: any) {
    console.error('Error sharing post:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to share post',
      error: error.message
    });
  }
};

// Get bookmarked posts
export const getBookmarkedPosts = async (req: AuthRequest, res: Response) => {
  try {
    const userId = req.user?.id || req.user?._id;
    if (!userId) {
      return res.status(401).json({
        success: false,
        message: 'Unauthorized'
      });
    }

    const page = parseInt(req.query.page as string) || 1;
    const limit = parseInt(req.query.limit as string) || 10;
    const skip = (page - 1) * limit;

    // Find posts that the current user has bookmarked
    const posts = await Post.find({
      bookmarks: userId
    })
      .populate('author', 'name profileImage role classYear email')
      .populate({
        path: 'sharedPost',
        populate: {
          path: 'author',
          select: 'name profileImage role classYear email'
        }
      })
      .sort({ createdAt: -1 })
      .skip(skip)
      .limit(limit);

    const total = await Post.countDocuments({
      bookmarks: userId
    });

    return res.status(200).json({
      success: true,
      data: posts,
      pagination: {
        total,
        page,
        pages: Math.ceil(total / limit)
      }
    });
  } catch (error: any) {
    console.error('Error getting bookmarked posts:', error);
    return res.status(500).json({
      success: false,
      message: 'Failed to get bookmarked posts',
      error: error.message
    });
  }
};

// Get feed posts
export const getFeedPosts = async (req: AuthRequest, res: Response) => {
  try {
    const userId = req.user?.id || req.user?._id;
    if (!userId) {
      return res.status(401).json({
        success: false,
        message: 'Unauthorized'
      });
    }

    // Get user's connections
    const user = await User.findById(userId);
    if (!user) {
      return res.status(404).json({
        success: false,
        message: 'User not found'
      });
    }
    
    if (!user.connections || user.connections.length === 0) {
      // If user has no connections, return empty array
      return res.status(200).json({
        success: true,
        data: [],
        message: 'You have no connections yet. Connect with other alumni to see their posts.'
      });
    }

    const page = parseInt(req.query.page as string) || 1;
    const limit = parseInt(req.query.limit as string) || 10;
    const skip = (page - 1) * limit;

    // Find posts from user's connections
    const posts = await Post.find({
      author: { $in: user.connections },
      visibility: { $ne: 'private' } // Exclude private posts
    })
      .populate('author', 'name profileImage role classYear email')
      .populate({
        path: 'sharedPost',
        populate: {
          path: 'author',
          select: 'name profileImage role classYear email'
        }
      })
      .sort({ createdAt: -1 })
      .skip(skip)
      .limit(limit);

    const total = await Post.countDocuments({
      author: { $in: user.connections },
      visibility: { $ne: 'private' }
    });

    return res.status(200).json({
      success: true,
      data: posts,
      pagination: {
        total,
        page,
        pages: Math.ceil(total / limit)
      }
    });
  } catch (error: any) {
    console.error('Error getting feed posts:', error);
    return res.status(500).json({
      success: false,
      message: 'Failed to get feed posts',
      error: error.message
    });
  }
};
