// React to a post (with specific reaction type)
export const reactToPost = async (req: AuthRequest, res: Response): Promise<void> => {
  try {
    const { postId } = req.params;
    const { reactionType } = req.body;
    const userId = req.user?.id;

    if (!userId) {
      res.status(401).json({
        success: false,
        message: 'User not authenticated'
      });
      return;
    }

    if (!['like', 'love', 'celebrate', 'support', 'insightful', 'funny'].includes(reactionType)) {
      res.status(400).json({
        success: false,
        message: 'Invalid reaction type'
      });
      return;
    }

    const post = await Post.findById(postId);
    if (!post) {
      res.status(404).json({
        success: false,
        message: 'Post not found'
      });
      return;
    }

    // Remove any existing reaction from this user
    post.reactions = post.reactions.filter(reaction => reaction.userId.toString() !== userId);
    
    // Also remove from likes array to maintain backward compatibility
    post.likes = post.likes.filter(like => like.toString() !== userId);
    
    // Add the new reaction
    post.reactions.push({
      userId: userId as any,
      type: reactionType as any
    });
    
    // If reaction is 'like', also add to likes array for compatibility
    if (reactionType === 'like') {
      post.likes.push(userId as any);
    }
    
    await post.save();

    // Get reaction counts for response
    const reactionCounts = {
      like: post.reactions.filter(r => r.type === 'like').length,
      love: post.reactions.filter(r => r.type === 'love').length,
      celebrate: post.reactions.filter(r => r.type === 'celebrate').length,
      support: post.reactions.filter(r => r.type === 'support').length,
      insightful: post.reactions.filter(r => r.type === 'insightful').length,
      funny: post.reactions.filter(r => r.type === 'funny').length,
    };

    res.json({
      success: true,
      message: 'Reaction added successfully',
      data: {
        reactions: reactionCounts,
        totalReactions: post.reactions.length,
        userReaction: reactionType
      }
    });
  } catch (error) {
    console.error('Error reacting to post:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to react to post'
    });
  }
};

// Remove reaction from a post
export const removeReaction = async (req: AuthRequest, res: Response): Promise<void> => {
  try {
    const { postId } = req.params;
    const userId = req.user?.id;

    if (!userId) {
      res.status(401).json({
        success: false,
        message: 'User not authenticated'
      });
      return;
    }

    const post = await Post.findById(postId);
    if (!post) {
      res.status(404).json({
        success: false,
        message: 'Post not found'
      });
      return;
    }

    // Check if user has reacted to the post
    const hasReacted = post.reactions.some(reaction => reaction.userId.toString() === userId);
    if (!hasReacted) {
      res.status(400).json({
        success: false,
        message: 'No reaction to remove'
      });
      return;
    }

    // Remove any reaction from this user
    post.reactions = post.reactions.filter(reaction => reaction.userId.toString() !== userId);
    
    // Also remove from likes array to maintain backward compatibility
    post.likes = post.likes.filter(like => like.toString() !== userId);
    
    await post.save();

    // Get reaction counts for response
    const reactionCounts = {
      like: post.reactions.filter(r => r.type === 'like').length,
      love: post.reactions.filter(r => r.type === 'love').length,
      celebrate: post.reactions.filter(r => r.type === 'celebrate').length,
      support: post.reactions.filter(r => r.type === 'support').length,
      insightful: post.reactions.filter(r => r.type === 'insightful').length,
      funny: post.reactions.filter(r => r.type === 'funny').length,
    };

    res.json({
      success: true,
      message: 'Reaction removed successfully',
      data: {
        reactions: reactionCounts,
        totalReactions: post.reactions.length,
        userReaction: null
      }
    });
  } catch (error) {
    console.error('Error removing reaction from post:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to remove reaction'
    });
  }
};

// Bookmark a post
export const bookmarkPost = async (req: AuthRequest, res: Response): Promise<void> => {
  try {
    const { postId } = req.params;
    const userId = req.user?.id;

    if (!userId) {
      res.status(401).json({
        success: false,
        message: 'User not authenticated'
      });
      return;
    }

    const post = await Post.findById(postId);
    if (!post) {
      res.status(404).json({
        success: false,
        message: 'Post not found'
      });
      return;
    }

    // Check if post is already bookmarked
    if (post.bookmarks.includes(userId as any)) {
      res.status(400).json({
        success: false,
        message: 'Post already bookmarked'
      });
      return;
    }

    // Add user to bookmarks array
    post.bookmarks.push(userId as any);
    await post.save();

    res.json({
      success: true,
      message: 'Post bookmarked successfully',
      data: {
        bookmarks: post.bookmarks.length,
        isBookmarked: true
      }
    });
  } catch (error) {
    console.error('Error bookmarking post:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to bookmark post'
    });
  }
};

// Remove bookmark from a post
export const unbookmarkPost = async (req: AuthRequest, res: Response): Promise<void> => {
  try {
    const { postId } = req.params;
    const userId = req.user?.id;

    if (!userId) {
      res.status(401).json({
        success: false,
        message: 'User not authenticated'
      });
      return;
    }

    const post = await Post.findById(postId);
    if (!post) {
      res.status(404).json({
        success: false,
        message: 'Post not found'
      });
      return;
    }

    // Check if post is bookmarked
    if (!post.bookmarks.includes(userId as any)) {
      res.status(400).json({
        success: false,
        message: 'Post not bookmarked'
      });
      return;
    }

    // Remove user from bookmarks array
    post.bookmarks = post.bookmarks.filter(bookmark => bookmark.toString() !== userId);
    await post.save();

    res.json({
      success: true,
      message: 'Bookmark removed successfully',
      data: {
        bookmarks: post.bookmarks.length,
        isBookmarked: false
      }
    });
  } catch (error) {
    console.error('Error removing bookmark:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to remove bookmark'
    });
  }
};

// Vote on a poll
export const voteOnPoll = async (req: AuthRequest, res: Response): Promise<void> => {
  try {
    const { postId } = req.params;
    const { optionIndex } = req.body;
    const userId = req.user?.id;

    if (!userId) {
      res.status(401).json({
        success: false,
        message: 'User not authenticated'
      });
      return;
    }

    const post = await Post.findById(postId);
    if (!post) {
      res.status(404).json({
        success: false,
        message: 'Post not found'
      });
      return;
    }

    if (!post.pollOptions || post.pollOptions.length === 0) {
      res.status(400).json({
        success: false,
        message: 'This post does not have a poll'
      });
      return;
    }

    if (optionIndex < 0 || optionIndex >= post.pollOptions.length) {
      res.status(400).json({
        success: false,
        message: 'Invalid poll option'
      });
      return;
    }

    // Check if poll has ended
    if (post.pollEndsAt && new Date(post.pollEndsAt) < new Date()) {
      res.status(400).json({
        success: false,
        message: 'This poll has ended'
      });
      return;
    }

    // Check if user has already voted on any option
    let hasVoted = false;
    let previousVoteIndex = -1;
    
    post.pollOptions.forEach((option, index) => {
      if (option.votes.includes(userId as any)) {
        hasVoted = true;
        previousVoteIndex = index;
      }
    });

    // If user already voted on the same option, remove the vote
    if (hasVoted && previousVoteIndex === optionIndex && post.pollOptions && post.pollOptions[previousVoteIndex]) {
      post.pollOptions[previousVoteIndex]!.votes = post.pollOptions[previousVoteIndex]!.votes
        .filter(vote => vote.toString() !== userId);
    } 
    // If user voted on different option, move the vote
    else if (hasVoted && post.pollOptions && post.pollOptions[previousVoteIndex] && post.pollOptions[optionIndex]) {
      post.pollOptions[previousVoteIndex]!.votes = post.pollOptions[previousVoteIndex]!.votes
        .filter(vote => vote.toString() !== userId);
      post.pollOptions[optionIndex]!.votes.push(userId as any);
    } 
    // If user hasn't voted, add the vote
    else if (post.pollOptions && post.pollOptions[optionIndex]) {
      post.pollOptions[optionIndex]!.votes.push(userId as any);
    }

    await post.save();

    // Calculate poll stats for response
    const totalVotes = post.pollOptions?.reduce((sum, option) => sum + option.votes.length, 0) || 0;
    const pollStats = post.pollOptions?.map((option) => {
      return {
        text: option.text,
        votes: option.votes.length,
        percentage: totalVotes > 0 ? Math.round((option.votes.length / totalVotes) * 100) : 0,
        isSelectedByUser: option.votes.some(vote => vote.toString() === userId)
      };
    });

    res.json({
      success: true,
      message: 'Vote recorded successfully',
      data: {
        pollStats,
        totalVotes,
        userVoted: post.pollOptions.some(option => option.votes.includes(userId as any))
      }
    });
  } catch (error) {
    console.error('Error voting on poll:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to record vote'
    });
  }
};

// Increase share count for a post
export const sharePost = async (req: AuthRequest, res: Response): Promise<void> => {
  try {
    const { postId } = req.params;
    const { comment } = req.body;
    const userId = req.user?._id;

    if (!userId) {
      res.status(401).json({
        success: false,
        message: 'Unauthorized'
      });
      return;
    }

    const originalPost = await Post.findById(postId);
    if (!originalPost) {
      res.status(404).json({
        success: false,
        message: 'Post not found'
      });
      return;
    }

    // Increment share count on the original post
    originalPost.shareCount = (originalPost.shareCount || 0) + 1;
    await originalPost.save();

    // If there's a comment, create a new post as a share with comment (quote post)
    if (comment && comment.trim()) {
      // Create a new post that references the original
      const newPost = new Post({
        content: comment.trim(),
        author: userId,
        sharedPost: postId,
        visibility: originalPost.visibility === 'private' ? 'connections' : originalPost.visibility,
        shareType: 'quote'
      });

      await newPost.save();

      res.json({
        success: true,
        message: 'Post shared with comment',
        data: {
          shareCount: originalPost.shareCount,
          post: newPost
        }
      });
    } else {
      // Simple share without creating a new post
      res.json({
        success: true,
        message: 'Post shared',
        data: {
          shareCount: originalPost.shareCount
        }
      });
    }
  } catch (error: any) {
    console.error('Error sharing post:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to share post',
      error: error.message
    });
  }
};

// Get bookmarked posts
export const getBookmarkedPosts = async (req: Request, res: Response) => {
  try {
    const userId = req.user?._id;
    if (!userId) {
      return res.status(401).json({
        success: false,
        message: 'Unauthorized'
      });
    }

    const page = parseInt(req.query.page as string) || 1;
    const limit = parseInt(req.query.limit as string) || 10;
    const skip = (page - 1) * limit;

    // Find posts that the current user has bookmarked
    const posts = await Post.find({
      bookmarks: userId
    })
      .populate('author', 'name profileImage role classYear email')
      .populate({
        path: 'sharedPost',
        populate: {
          path: 'author',
          select: 'name profileImage role classYear email'
        }
      })
      .sort({ createdAt: -1 })
      .skip(skip)
      .limit(limit);

    const total = await Post.countDocuments({ bookmarks: userId });

    return res.status(200).json({
      success: true,
      data: posts,
      pagination: {
        total,
        page,
        pages: Math.ceil(total / limit)
      }
    });
  } catch (error: any) {
    console.error('Error getting bookmarked posts:', error);
    return res.status(500).json({
      success: false,
      message: 'Failed to get bookmarked posts',
      error: error.message
    });
  }
};

// Get feed posts
export const getFeedPosts = async (req: Request, res: Response) => {
  try {
    const userId = req.user?._id;
    if (!userId) {
      return res.status(401).json({
        success: false,
        message: 'Unauthorized'
      });
    }

    // Get user's connections
    const user = await User.findById(userId);
    if (!user || !user.connections || user.connections.length === 0) {
      // If user has no connections, return empty array
      return res.status(200).json({
        success: true,
        data: [],
        message: 'You have no connections yet. Connect with other alumni to see their posts.'
      });
    }

    const page = parseInt(req.query.page as string) || 1;
    const limit = parseInt(req.query.limit as string) || 10;
    const skip = (page - 1) * limit;

    // Find posts from user's connections
    const posts = await Post.find({
      author: { $in: user.connections },
      visibility: { $ne: 'private' } // Exclude private posts
    })
      .populate('author', 'name profileImage role classYear email')
      .populate({
        path: 'sharedPost',
        populate: {
          path: 'author',
          select: 'name profileImage role classYear email'
        }
      })
      .sort({ createdAt: -1 })
      .skip(skip)
      .limit(limit);

    const total = await Post.countDocuments({
      author: { $in: user.connections },
      visibility: { $ne: 'private' }
    });

    return res.status(200).json({
      success: true,
      data: posts,
      pagination: {
        total,
        page,
        pages: Math.ceil(total / limit)
      }
    });
  } catch (error: any) {
    console.error('Error getting feed posts:', error);
    return res.status(500).json({
      success: false,
      message: 'Failed to get feed posts',
      error: error.message
    });
  }
};
