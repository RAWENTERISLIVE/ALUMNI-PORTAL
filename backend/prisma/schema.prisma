generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum AccountType {
  ALUMNI
  FACULTY
}

enum Status {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum Visibility {
  PUBLIC
  ALUMNI
  CONNECTIONS
  ALUMNI_ONLY
  FACULTY_ONLY
  CONNECTIONS_ONLY
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  password                 String
  name                     String
  firstName                String?
  lastName                 String?
  admissionNumber          String
  admissionYear            String
  accountType              AccountType @default(ALUMNI)
  role                     Role      @default(USER)
  status                   Status    @default(PENDING)
  isVerified               Boolean   @default(false)
  profileImage             String?
  bio                      String?
  headline                 String?
  city                     String?
  country                  String?
  contactEmail             String?
  contactPhone             String?
  linkedInProfile          String?
  company                  String?
  jobTitle                 String?
  isAvailableAsMentor      Boolean   @default(false)
  location                 String?
  lastLogin                DateTime?
  refreshTokens            String[]
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  needsManualVerification  Boolean   @default(false)
  verificationDetails      String?
  facultyIdCardUrl         String?
  hasPremiumBadge          Boolean   @default(false)

  // Settings as JSON or separate relationships (using JSON for simplicity with Prisma/Postgres)
  notificationSettings Json?
  privacySettings      Json?
  experiences          Json?
  educations           Json?
  skills               String[]
  interests            String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  posts         Post[]         @relation("UserPosts")
  jobsPosted    Job[]          @relation("JobPostedBy")
  savedJobs     Job[]          @relation("SavedJobs")
  comments      Comment[]      @relation("UserComments")
  commentLikes  Comment[]      @relation("CommentLikes")
  postReactions PostReaction[]
  postBookmarks Post[]         @relation("BookmarkedPosts")
  postMentions  Post[]         @relation("PostMentions")

  // Connections (self-relation)
  connections User[] @relation("UserConnections")
  connectedTo User[] @relation("UserConnections")

  sentConnectionRequests     ConnectionRequest[] @relation("ConnectionRequestSender")
  receivedConnectionRequests ConnectionRequest[] @relation("ConnectionRequestReceiver")
  followingRelationships     Follow[]            @relation("UserFollowing")
  followerRelationships      Follow[]            @relation("UserFollowers")
  sentDirectMessages         DirectMessage[]     @relation("DirectMessageSender")
  receivedDirectMessages     DirectMessage[]     @relation("DirectMessageReceiver")

  // Additional relationships
  mentorshipProfile MentorshipProfile? @relation("UserMentorshipProfile")
  mentorshipRequestsAsMentee MentorshipRequest[] @relation("MenteeRequests")
  eventsOrganized   Event[]            @relation("EventOrganizer")
  eventsAttended    Event[]            @relation("EventAttendees")
  groupsCreated     Group[]            @relation("GroupCreator")
  groupsJoined      Group[]            @relation("GroupMembers")
  groupJoinRequests GroupJoinRequest[] @relation("GroupJoinRequestRequester")
  groupMessages     GroupMessage[]     @relation("GroupMessageAuthor")
  reportsSubmitted  Report[]           @relation("ReportedBy")
  reportsAgainst    Report[]           @relation("ReportedUser")
  reportsReviewed   Report[]           @relation("ReviewedBy")
  filesUploaded     File[]             @relation("FileUploader")
  notifications     Notification[]     @relation("UserNotifications")

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([role, createdAt])
  @@index([accountType, status])
  @@index([admissionYear, status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info")
  actionUrl String?
  metadata  Json?
  isSeen    Boolean  @default(false)
  seenAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isSeen, createdAt])
}

model ConnectionRequest {
  id         String                  @id @default(uuid())
  senderId   String
  receiverId String
  sender     User                    @relation("ConnectionRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User                    @relation("ConnectionRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status     ConnectionRequestStatus @default(PENDING)
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model DirectMessage {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  sender     User     @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("DirectMessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  isRead     Boolean  @default(false)
  readAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, isRead, createdAt])
}

model Post {
  id             String   @id @default(uuid())
  title          String?
  content        String
  authorId       String
  author         User     @relation("UserPosts", fields: [authorId], references: [id])
  category       String   @default("general")
  isFeatured     Boolean  @default(false)
  isSchoolUpdate Boolean  @default(false)
  visibility     String   @default("public")
  tags           String[]
  attachments    Json? // [{type, url, name, size, extension}]
  externalLinks  String[]

  // Shared post
  sharedPostId String?
  sharedPost   Post?   @relation("SharedPost", fields: [sharedPostId], references: [id])
  sharedBy     Post[]  @relation("SharedPost")
  shareType    String?
  shareCount   Int     @default(0)

  // Computed/cached
  commentCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  reactions PostReaction[]
  bookmarks User[]         @relation("BookmarkedPosts")
  comments  Comment[]      @relation("PostComments")
  mentions  User[]         @relation("PostMentions")

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([category, createdAt])
  @@index([visibility, createdAt])
  @@index([isFeatured, createdAt])
  @@index([isSchoolUpdate, createdAt])
}

model PostReaction {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   String @default("like") // 'like', 'love', 'celebrate', etc.

  @@unique([postId, userId]) // User can only react once per post
  @@index([userId, postId, type])
}

model Comment {
  id       String @id @default(uuid())
  content  String
  authorId String
  author   User   @relation("UserComments", fields: [authorId], references: [id])
  postId   String
  post     Post   @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)

  // Recursive replies
  parentCommentId String?
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes User[] @relation("CommentLikes")
}

model Job {
  id                  String    @id @default(uuid())
  title               String
  company             String
  location            String
  type                String // 'full-time', 'part-time', etc.
  salaryRangeMin      Float?
  salaryRangeMax      Float?
  salaryCurrency      String    @default("USD")
  description         String
  requirements        String[]
  benefits            String[]
  postedById          String
  postedBy            User      @relation("JobPostedBy", fields: [postedById], references: [id])
  postedByName        String
  applicationUrl      String?
  contactEmail        String?
  isAlumniReferral    Boolean   @default(true)
  applicationDeadline DateTime?
  isActive            Boolean   @default(true)
  applicationCount    Int       @default(0)
  tags                String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedBy User[] @relation("SavedJobs")

  @@index([createdAt])
  @@index([isActive, createdAt])
  @@index([postedById, createdAt])
  @@index([type, createdAt])
}

model MentorshipProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation("UserMentorshipProfile", fields: [userId], references: [id], onDelete: Cascade)
  isMentor        Boolean @default(false)
  isSeekingMentor Boolean @default(false)

  // Mentor fields
  expertise            String[]
  experience           String?
  industry             String?
  company              String?
  position             String?
  yearsOfExperience    Int      @default(0)
  bio                  String?
  availability         String   @default("medium")
  preferredMenteeLevel String[]
  maxMentees           Int      @default(3)
  currentMentees       Int      @default(0)

  // Mentee fields
  careerGoals               String[]
  currentLevel              String?
  interestedFields          String[]
  mentorshipGoals           String?
  preferredMentorExperience String?

  // Common fields
  communicationPreferences String[]
  timezone                 String   @default("UTC")
  linkedInUrl              String?
  portfolioUrl             String?

  isActive          Boolean @default(true)
  rating            Float   @default(0)
  totalRatings      Int     @default(0)
  successfulMatches Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorshipRequests MentorshipRequest[] @relation("MentorRequests")
}

model Event {
  id            String    @id @default(uuid())
  title         String
  description   String
  date          DateTime
  endDate       DateTime?
  time          String
  location      String
  organizerId   String
  organizer     User      @relation("EventOrganizer", fields: [organizerId], references: [id])
  attendees     User[]    @relation("EventAttendees")
  maxAttendees  Int?
  isVirtual     Boolean   @default(false)
  meetingLink   String?
  category      String    @default("other")
  status        String    @default("upcoming")
  imageUrl      String?
  isSchoolEvent Boolean   @default(false)
  tags          String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Group {
  id           String   @id @default(uuid())
  name         String
  description  String
  creatorId    String
  creator      User     @relation("GroupCreator", fields: [creatorId], references: [id])
  members      User[]   @relation("GroupMembers")
  privacy      String   @default("public")
  memberCount  Int      @default(0) // Although we can count members, caching it is fine
  category     String   @default("professional")
  lastActivity DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages GroupMessage[] @relation("GroupMessages")
  joinRequests GroupJoinRequest[] @relation("GroupJoinRequestGroup")
}

model GroupJoinRequest {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation("GroupJoinRequestGroup", fields: [groupId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User     @relation("GroupJoinRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // pending | approved | rejected
  reviewedById String?
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, requesterId])
  @@index([groupId, status, createdAt])
}

model GroupMessage {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation("GroupMessages", fields: [groupId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("GroupMessageAuthor", fields: [authorId], references: [id])
  content     String
  messageType String   @default("text")
  attachments String[]

  replyToId String?
  replyTo   GroupMessage?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   GroupMessage[] @relation("MessageReplies")

  reactions Json? // [{emoji: string, users: string[]}]
  isEdited  Boolean   @default(false)
  editedAt  DateTime?

  createdAt DateTime @default(now())
}

model Report {
  id             String  @id @default(uuid())
  type           String
  description    String
  reason         String
  reportedById   String
  reportedBy     User    @relation("ReportedBy", fields: [reportedById], references: [id])
  reportedUserId String?
  reportedUser   User?   @relation("ReportedUser", fields: [reportedUserId], references: [id])

  // To avoid circular or complex polymorphism in Prisma, we use string IDs for other types, or optional relations.
  reportedPostId    String?
  reportedCommentId String?
  reportedGroupId   String?
  reportedJobId     String?

  status       String    @default("pending")
  adminNotes   String?
  reviewedById String?
  reviewedBy   User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File {
  id           String @id @default(uuid())
  filename     String @unique
  originalName String
  mimetype     String
  size         Int
  path         String
  url          String
  uploadedById String
  uploadedBy   User   @relation("FileUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MentorshipRequest {
  id               String            @id @default(uuid())
  menteeId         String
  mentee           User              @relation("MenteeRequests", fields: [menteeId], references: [id], onDelete: Cascade)
  mentorProfileId  String
  mentor           MentorshipProfile @relation("MentorRequests", fields: [mentorProfileId], references: [id], onDelete: Cascade)
  message          String?
  status           String            @default("pending") // pending, accepted, rejected, completed
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}
