# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL via Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/alumni_portal

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_COOKIE_MAX_AGE_MS=2592000000

# File Upload Configuration
UPLOADS_DIR=./uploads
MAX_FILE_SIZE=52428800

# Frontend Configuration
FRONTEND_URL=http://localhost:8080

# LinkedIn OAuth (required for true auto-import)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/linkedin/callback
# Example scopes. For DMA Pages Data Portability, include approved product scopes.
LINKEDIN_SCOPES=openid profile email

# Email Configuration (for future use)
EMAIL_FROM=noreply@alumniconnect.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-in-production

# Features Toggle (Phase Implementation)
ENABLE_REGISTRATIONS=true
ENABLE_MANUAL_VERIFICATION=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false

# System Accounts
# Hidden from directory/admin listing APIs.
HIDDEN_SYSTEM_ACCOUNT_EMAILS=futurist.raghav@gmail.com

# Seeded super-admin account passwords (used by `npx prisma db seed`)
SEED_SUPER_ADMIN_1_PASSWORD=Admin123!@#
SEED_SUPER_ADMIN_2_PASSWORD=bajmav-1qojmu-qoKkod