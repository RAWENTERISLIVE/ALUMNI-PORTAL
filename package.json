{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend": "cd backend && npm run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run backend\"",
    "build": "vite build",
    "cf:build": "npm run build",
    "cf:dev": "npm run build && npx wrangler dev",
    "cf:worker:whoami": "npx wrangler whoami",
    "cf:d1:create": "npx wrangler d1 create mpsajmer-connect-db",
    "cf:d1:migrate:local": "npx wrangler d1 migrations apply DB --local",
    "cf:d1:migrate:remote": "npx wrangler d1 migrations apply DB --remote",
    "cf:r2:create": "npx wrangler r2 bucket create mpsajmer-connect-uploads",
    "cf:proxy:secret": "./scripts/cf-set-api-proxy-origin.sh",
    "cf:deploy": "npm run build && npm run cf:proxy:secret && npx wrangler deploy",
    "deploy:stack": "./scripts/deploy-fullstack.sh",
    "deploy:stack:reset": "RESET_DB=1 ./scripts/deploy-fullstack.sh",
    "deploy:stack:down": "docker-compose --env-file .env.docker -f docker-compose.full.yml down --remove-orphans",
    "deploy:stack:logs": "docker-compose --env-file .env.docker -f docker-compose.full.yml logs -f",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "setup:phase1": "./setup-phase1.sh",
    "validate:phase1": "./validate-phase1.sh",
    "start:phase1": "npm run dev:full"
  },
