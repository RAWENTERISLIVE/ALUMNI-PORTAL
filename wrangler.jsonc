{
	"name": "mpsajmer-connect",
	"pages_build_output_dir": "./dist",
	"compatibility_date": "2026-03-31",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mpsajmer-connect-db",
			"database_id": "fa1f7c86-d341-4bf2-aeaa-01d2ca2267b1",
			"migrations_dir": "./cloudflare/d1/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "UPLOADS_BUCKET",
			"bucket_name": "mpsajmer-connect-uploads"
		}
	],
	"services": [
		{
			"binding": "BACKEND",
			"service": "mpsajmer-connect-api"
		}
	],
	"vars": {
		"APP_ENV": "production"
	}
}